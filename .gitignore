# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Swarm e2e cluster runtime (cloud images, disks, pidfiles, seeds)
e2e/swarm/.cache/
e2e/swarm/.run/

# Registry e2e runtime (cloud images, disks, pidfiles, htpasswd)
e2e/registry/.cache/
e2e/registry/.run/

# Live session memo cache
.containerkit/

# Local full TSX application. Not part of the published tree yet.
/playground/

# Containerkit npm package (TSX)
tsx/node_modules/
tsx/dist/
tsx/dist-test/
tsx/dist-examples/
tsx/*.tgz

# Multi-platform runner archives
/dist/

# Go binaries and the Apache NOTICE copied into the npm platform packages by tools/crossbuild.
# prepack copies those binaries under tsx/bin/<os>-<arch>/ and postpack removes them.
npm/@aptd3v/containerkit-*/bin/
npm/@aptd3v/containerkit-*/NOTICE
tsx/bin/*/
tsx/package.json.publish-backup

# Supabase example runtime (bind mounts + exported compose)
/volumes/
/docker-compose.yaml
examples/supabase/volumes/
examples/supabase/docker-compose.yaml

# WordPress example runtime
/examples/wordpress/database/
/examples/wordpress/docker-compose.yaml
/examples/wordpress/haproxy.cfg
/examples/wordpress/src/

#astronomy example runtime
/examples/astronomy_shop/volumes/
/examples/astronomy_shop/docker-compose.yaml
astronomy-shop.compose.yaml

# Python scripts
scripts/__pycache__/

