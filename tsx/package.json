{
  "name": "containerkit",
  "version": "0.8.1",
  "description": "Write Compose files, Dockerfiles, and container actions as TSX.",
  "type": "module",
  "license": "MIT",
  "author": "aptd3v",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aptd3v/containerkit.git",
    "directory": "tsx"
  },
  "bugs": {
    "url": "https://github.com/aptd3v/containerkit/issues"
  },
  "homepage": "https://github.com/aptd3v/containerkit/tree/main/tsx#readme",
  "keywords": [
    "docker",
    "compose",
    "jsx",
    "tsx",
    "containerkit"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./dockerfile": {
      "types": "./dist/docker-file.d.ts",
      "import": "./dist/docker-file.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js"
    },
    "./vocab": {
      "types": "./dist/vocab.d.ts",
      "import": "./dist/vocab.js"
    },
    "./taskflow": {
      "types": "./dist/taskflow.d.ts",
      "import": "./dist/taskflow.js"
    },
    "./tsconfig.jsx.json": "./tsconfig.jsx.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "containerkit": "./bin/containerkit.js"
  },
  "files": [
    "bin/containerkit.js",
    "dist",
    "README.md",
    "GUIDE.md",
    "docs",
    "LICENSE",
    "tsconfig.jsx.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "go run ../tools/gentsx",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p coexist-test/tsconfig.json && node --test dist-test/node.test.js dist-test/render.test.js dist-test/jsx.test.js dist-test/plan.test.js dist-test/runner.test.js dist-test/docker-file.test.js dist-test/vocab.test.js dist-test/live.test.js dist-test/taskflow.test.js bin/containerkit.test.js scripts/publish-optional.test.js",
    "test:taskflow": "tsc -p tsconfig.test.json && node --test --experimental-test-coverage --test-coverage-include=dist-test/taskflow.js --test-coverage-lines=100 dist-test/taskflow.test.js",
    "dockerfile": "tsc -p tsconfig.build.json && tsc -p examples/tsconfig.json && node dist-examples/image.js",
    "supabase": "tsc -p tsconfig.build.json && tsc -p examples/tsconfig.json && node dist-examples/supabase.js",
    "taskflow": "tsc -p tsconfig.build.json && tsc -p examples/tsconfig.json && node dist-examples/taskflow.js",
    "pack:check": "npm run build && node scripts/pack-check.mjs",
    "prepack": "node scripts/publish-optional.mjs rewrite",
    "postpack": "node scripts/publish-optional.mjs restore",
    "prepublishOnly": "node scripts/publish-optional.mjs check"
  },
  "optionalDependencies": {
    "@containerkit/darwin-amd64": "file:../npm/@containerkit/darwin-amd64",
    "@containerkit/darwin-arm64": "file:../npm/@containerkit/darwin-arm64",
    "@containerkit/linux-amd64": "file:../npm/@containerkit/linux-amd64",
    "@containerkit/linux-arm64": "file:../npm/@containerkit/linux-arm64",
    "@containerkit/windows-amd64": "file:../npm/@containerkit/windows-amd64",
    "@containerkit/windows-arm64": "file:../npm/@containerkit/windows-arm64"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
